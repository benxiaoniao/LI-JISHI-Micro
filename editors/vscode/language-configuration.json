{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "“", "close": "”" },
    { "open": "‘", "close": "’" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"],
    ["“", "”"]
  ],
  "indentationRules": {
    "increaseIndentPattern": ".*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:否则|否则如果|函数|返回|中断|继续)(?![A-Za-z0-9_\\u4e00-\\u9fff])"
  }
}
