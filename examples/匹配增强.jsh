函数 等级(分):
    匹配 分:
        情形 90..100:
            返回 "优"
        情形 60..89:
            返回 "及格"
        情形 其他:
            返回 "不及格"

打印(等级(95), 等级(70), 等级(30))

函数 奇数(数):
    匹配 数:
        情形 1, 3, 5:
            返回 真
        情形 其他:
            返回 假
打印(奇数(3), 奇数(4))

函数 档位(n):
    返回 匹配 n:
        情形 0: "零"
        情形 1, 2: "很少"
        情形 3..9: "一些"
        情形 其他: "很多"
打印(档位(0), 档位(2), 档位(7), 档位(42))
