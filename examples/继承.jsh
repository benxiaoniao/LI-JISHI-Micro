类 动物:
    令 名字 = "无名"
    令 腿 = 0
    函数 初始化():
        本.名字 = "动物"
        本.腿 = 4
    函数 介绍():
        返回 本.名字 + "，" + 本.叫声() + "（" + 文本(本.腿) + " 条腿）"
    函数 叫声():
        返回 "……"

类 狗 继承 动物:
    令 品种 = "中华田园犬"
    函数 叫声():
        返回 "汪汪"

类 幼犬 继承 狗:
    令 月龄 = 1
    函数 初始化(品种名, 月):
        本.品种 = 品种名
        本.月龄 = 月
    函数 叫声():
        返回 "嗷"

令 a = 新建 动物()
打印("动物:", a.介绍())

令 d = 新建 狗()
打印("狗:", d.介绍(), d.品种, "腿:", d.腿)

令 p = 新建 幼犬("柴犬", 3)
打印("幼犬:", p.介绍(), p.品种, p.月龄)
打印("实例:", p)

p.腿 = 3
打印("改父字段:", p.腿)

如果 p.介绍() == "动物，嗷（3 条腿）":
    打印("覆写与派发: 通过")

函数 叫一声(对象):
    返回 对象.叫声()

打印("传参多态:", 叫一声(a), 叫一声(d), 叫一声(p))
