导入 定时器
导入 总线

# 砾：OLED 长跑稳定性验证（显示路径与 examples/board/OLED文字.jsh 完全一致）
# 只改主循环：限定帧数、逐帧打印帧序号与推页耗时，便于串口侧做连续性判定。
# 两个旋钮在下面「长测参数」：401 帧档设 总帧 = 401 / 帧间隔 = 500；4001 帧加压档设 4001 / 100。
# 实测结果与观测口径见 docs/原生函数表.md §11.10。
# 接线：SCL = PB10（引脚 26），SDA = PB11（引脚 27），VCC = 3V3，GND = GND。

# ---------------- 5×7 ASCII 字库（每个字形 5 列，列内 bit0 在上） ----------------
令 字符集 = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_"

令 字库甲 = [
    0, 0, 0, 0, 0,
    0, 0, 95, 0, 0,
    0, 7, 0, 7, 0,
    20, 127, 20, 127, 20,
    36, 42, 127, 42, 18,
    35, 19, 8, 100, 98,
    54, 73, 85, 34, 80,
    0, 5, 3, 0, 0,
    0, 28, 34, 65, 0,
    0, 65, 34, 28, 0,
    34, 20, 127, 20, 34,
    8, 8, 62, 8, 8,
    0, 80, 48, 0, 0,
    8, 8, 8, 8, 8,
    0, 96, 96, 0, 0,
    32, 16, 8, 4, 2,
    62, 81, 73, 69, 62,
    0, 66, 127, 64, 0,
    66, 97, 81, 73, 70,
    33, 65, 69, 75, 49,
    24, 20, 18, 127, 16,
    39, 69, 69, 69, 57,
    60, 74, 73, 73, 48,
    1, 113, 9, 5, 3,
    54, 73, 73, 73, 54,
    6, 73, 73, 41, 30,
    0, 54, 54, 0, 0,
    0, 86, 54, 0, 0,
    8, 20, 34, 65, 0,
    20, 20, 20, 20, 20,
    0, 65, 34, 20, 8,
    2, 1, 81, 9, 6
]

令 字库乙 = [
    50, 73, 121, 65, 62,
    126, 17, 17, 17, 126,
    127, 73, 73, 73, 54,
    62, 65, 65, 65, 34,
    127, 65, 65, 34, 28,
    127, 73, 73, 73, 65,
    127, 9, 9, 9, 1,
    62, 65, 73, 73, 122,
    127, 8, 8, 8, 127,
    0, 65, 127, 65, 0,
    32, 64, 65, 63, 1,
    127, 8, 20, 34, 65,
    127, 64, 64, 64, 64,
    127, 2, 4, 2, 127,
    127, 4, 8, 16, 127,
    62, 65, 65, 65, 62,
    127, 9, 9, 9, 6,
    62, 65, 81, 33, 94,
    127, 9, 25, 41, 70,
    70, 73, 73, 73, 49,
    1, 1, 127, 1, 1,
    63, 64, 64, 64, 63,
    31, 32, 64, 32, 31,
    63, 64, 56, 64, 63,
    99, 20, 8, 20, 99,
    7, 8, 112, 8, 7,
    97, 81, 73, 69, 67,
    0, 127, 65, 65, 0,
    2, 4, 8, 16, 32,
    0, 65, 65, 127, 0,
    4, 2, 1, 2, 4,
    64, 64, 64, 64, 64
]

令 字库 = 字库甲 + 字库乙

令 屏址 = 60
令 屏宽 = 128

# ---------------- 长测参数 ----------------

令 总帧 = 4001        # 第二轮
令 帧间隔 = 100       # 第二轮加压：100 ms（终版是 500 ms，显示路径不变）

# ---------------- 基础事务 ----------------

函数 命令(值)：
    I2C写(屏址, 0, 值)

函数 设行(行)：
    命令(176 + 行)
    命令(0)
    命令(16)

# ---------------- SSD1306 初始化（与终版一致） ----------------

函数 屏初始化()：
    命令(174)
    命令(213)
    命令(128)
    命令(168)
    命令(63)
    命令(211)
    命令(0)
    命令(64)
    命令(141)
    命令(20)
    命令(32)
    命令(0)
    命令(161)
    命令(200)
    命令(218)
    命令(18)
    命令(129)
    命令(207)
    命令(217)
    命令(241)
    命令(219)
    命令(64)
    命令(164)
    命令(166)
    命令(175)

# ---------------- 绘图 ----------------

函数 字位置(字)：
    令 i = 0
    当 i < 64：
        如果 字符集[i] == 字：
            返回 i
        i = i + 1
    返回 0

# ---------------- 页缓冲（与终版一致） ----------------

令 缓冲 = [0]
循环 7 次：
    缓冲 = 缓冲 + 缓冲

函数 缓冲清零()：
    令 i = 0
    当 i < 屏宽：
        缓冲[i] = 0
        i = i + 1

函数 缓冲画段(文本内容, 起列)：
    令 列 = 起列
    遍历 字 在 文本内容：
        如果 列 > 122：
            中断
        令 基 = 字位置(字) * 5
        令 k = 0
        当 k < 5：
            如果 列 < 屏宽：
                缓冲[列] = 字库[基 + k]
            列 = 列 + 1
            k = k + 1
        列 = 列 + 1

函数 推页(页)：
    设行(页)
    令 基 = 0
    当 基 + 4 < 屏宽：
        I2C写块(屏址, 64, 缓冲[基], 缓冲[基 + 1], 缓冲[基 + 2], 缓冲[基 + 3], 缓冲[基 + 4])
        基 = 基 + 5
    I2C写块(屏址, 64, 缓冲[125], 缓冲[126], 缓冲[127])

函数 画页(页, 文本内容)：
    缓冲清零()
    缓冲画段(文本内容, 4)
    推页(页)

函数 首次清屏()：
    令 页号 = 0
    当 页号 < 8：
        缓冲清零()
        推页(页号)
        页号 = 页号 + 1

# ---------------- 计时辅助 ----------------

函数 毫秒差(起, 止)：
    令 d = 止 - 起
    如果 d < 0：
        d = d + 65536
    返回 d

# ---------------- 诊断：扫描 0x00–0x7F（与终版一致） ----------------

函数 扫描():
    打印("I2C 地址扫描（0x00–0x7F）：")
    令 找到 = 0
    遍历 地址 在 范围(0, 128):
        如果 I2C探测(地址):
            打印("  ACK 地址 =", 地址)
            找到 = 找到 + 1
    如果 找到 == 0:
        打印("  没有任何应答。分步检查：")
        打印("  1) VCC 是否 3V3、GND 是否共地")
        打印("  2) SDA/SCL 是否接反（SCL=PB10，SDA=PB11）")
        打印("  3) SCL/SDA 空闲是否约 3.3V（上拉是否有效）")
        打印("  4) 模块是不是 SPI 版（四针丝印不是 GND/VCC/SCL/SDA 就要停）")
    返回 找到

# ---------------- 主流程 ----------------

打印("砾：OLED 长跑稳定性验证")
打印("接线：PB10=SCL，PB11=SDA，VCC=3V3，GND=GND（模块自带 4.7k 上拉）")

定时器初始化()
令 硬件 = I2C初始化(26, 27, 400)
如果 硬件：
    打印("I2C 模式：硬件 I2C2（400 kHz）")
否则：
    打印("I2C 模式：软件位翻转")

如果 扫描():
    屏初始化()
    首次清屏()
    画页(0, "LI")
    画页(2, "JISHI MICRO")
    画页(4, "OLED 128X64")
    打印("长测开始 总帧 =", 总帧, "帧间隔 =", 帧间隔, "ms")

    令 计数 = 1
    令 上次推页 = 0
    令 累计 = 0
    令 推页累计 = 0
    令 推页最大 = 0
    令 推页最小 = 65535
    令 无应答 = 0

    当 计数 <= 总帧:
        令 帧起 = 定时器计数()
        缓冲清零()
        缓冲画段(文本(计数), 4)
        缓冲画段(文本(上次推页) + "MS", 64)
        令 s0 = 定时器计数()
        推页(6)
        令 s1 = 定时器计数()
        令 本帧推页 = 毫秒差(s0, s1)
        上次推页 = 本帧推页
        推页累计 += 本帧推页
        如果 本帧推页 > 推页最大:
            推页最大 = 本帧推页
        如果 本帧推页 < 推页最小:
            推页最小 = 本帧推页
        如果 I2C探测(屏址) == 假:
            无应答 += 1
            打印("!! 帧", 计数, "屏幕无应答")
        定时器延时(帧间隔)
        令 帧止 = 定时器计数()
        累计 += 毫秒差(帧起, 帧止)
        打印("帧", 计数, "推页", 本帧推页, "ms", "累计", 累计)
        计数 = 计数 + 1

    打印("长测结束 实跑帧数 =", 计数 - 1, "总耗时 =", 累计, "ms")
    打印("单帧平均 =", 累计 // (计数 - 1), "ms；推页平均 =", 推页累计 // (计数 - 1), "ms，最大 =", 推页最大, "ms，最小 =", 推页最小, "ms，无应答 =", 无应答)
否则：
    打印("未找到 I2C 设备，未初始化屏幕")
