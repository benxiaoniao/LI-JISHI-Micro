导入 定时器
导入 总线

# 砾：SSD1306 128×64（I2C）显示 ASCII 文字
# 驱动逻辑全部在本文件里：C 侧只提供「发字节 / 发短块」和延时，字库与显存组织都在 .jsh。
#
# 接线：SCL = PB10（引脚 26），SDA = PB11（引脚 27），VCC = 3V3，GND = GND。
# 四针模块一般自带 4.7k 上拉；没有上拉时 SCL/SDA 静态不会是高电平，扫描会扫不到。
# 只做 5×7 ASCII（32–95，64 个字形）；中文 16×16 字库放不下，不做。

# ---------------- 5×7 ASCII 字库（每个字形 5 列，列内 bit0 在上） ----------------
令 字符集 = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_"

令 字库甲 = [
    0, 0, 0, 0, 0,           # 空格
    0, 0, 95, 0, 0,          # !
    0, 7, 0, 7, 0,           # "
    20, 127, 20, 127, 20,    # #
    36, 42, 127, 42, 18,     # $
    35, 19, 8, 100, 98,      # %
    54, 73, 85, 34, 80,      # &
    0, 5, 3, 0, 0,           # '
    0, 28, 34, 65, 0,        # (
    0, 65, 34, 28, 0,        # )
    34, 20, 127, 20, 34,     # *
    8, 8, 62, 8, 8,          # +
    0, 80, 48, 0, 0,         # ,
    8, 8, 8, 8, 8,           # -
    0, 96, 96, 0, 0,         # .
    32, 16, 8, 4, 2,         # /
    62, 81, 73, 69, 62,      # 0
    0, 66, 127, 64, 0,       # 1
    66, 97, 81, 73, 70,      # 2
    33, 65, 69, 75, 49,      # 3
    24, 20, 18, 127, 16,     # 4
    39, 69, 69, 69, 57,      # 5
    60, 74, 73, 73, 48,      # 6
    1, 113, 9, 5, 3,         # 7
    54, 73, 73, 73, 54,      # 8
    6, 73, 73, 41, 30,       # 9
    0, 54, 54, 0, 0,         # :
    0, 86, 54, 0, 0,         # ;
    8, 20, 34, 65, 0,        # <
    20, 20, 20, 20, 20,      # =
    0, 65, 34, 20, 8,        # >
    2, 1, 81, 9, 6           # ?
]

令 字库乙 = [
    50, 73, 121, 65, 62,     # @
    126, 17, 17, 17, 126,    # A
    127, 73, 73, 73, 54,     # B
    62, 65, 65, 65, 34,      # C
    127, 65, 65, 34, 28,     # D
    127, 73, 73, 73, 65,     # E
    127, 9, 9, 9, 1,         # F
    62, 65, 73, 73, 122,     # G
    127, 8, 8, 8, 127,       # H
    0, 65, 127, 65, 0,       # I
    32, 64, 65, 63, 1,       # J
    127, 8, 20, 34, 65,      # K
    127, 64, 64, 64, 64,     # L
    127, 2, 4, 2, 127,       # M
    127, 4, 8, 16, 127,      # N
    62, 65, 65, 65, 62,      # O
    127, 9, 9, 9, 6,         # P
    62, 65, 81, 33, 94,      # Q
    127, 9, 25, 41, 70,      # R
    70, 73, 73, 73, 49,      # S
    1, 1, 127, 1, 1,         # T
    63, 64, 64, 64, 63,      # U
    31, 32, 64, 32, 31,      # V
    63, 64, 56, 64, 63,      # W
    99, 20, 8, 20, 99,       # X
    7, 8, 112, 8, 7,         # Y
    97, 81, 73, 69, 67,      # Z
    0, 127, 65, 65, 0,       # [
    2, 4, 8, 16, 32,         # \
    0, 65, 65, 127, 0,       # ]
    4, 2, 1, 2, 4,           # ^
    64, 64, 64, 64, 64       # _
]

令 字库 = 字库甲 + 字库乙

令 屏址 = 60        # 0x3C
令 屏宽 = 128

# ---------------- 基础事务 ----------------

函数 命令(值)：
    I2C写(屏址, 0, 值)          # 控制字节 0x00 = 命令

函数 设行(行)：
    命令(176 + 行)              # 0xB0 + 页号
    命令(0)                     # 列低 4 位 = 0
    命令(16)                    # 列高 4 位 = 0

# ---------------- SSD1306 初始化（128×64，I2C） ----------------

函数 屏初始化()：
    命令(174)       # 0xAE 关显示
    命令(213)       # 0xD5 时钟分频
    命令(128)       # 0x80
    命令(168)       # 0xA8 多路复用 1/64
    命令(63)        # 0x3F
    命令(211)       # 0xD3 显示偏移 0
    命令(0)
    命令(64)        # 0x40 起始行 0
    命令(141)       # 0x8D 电荷泵
    命令(20)        # 0x14 打开
    命令(32)        # 0x20 页寻址模式
    命令(0)         # 水平寻址
    命令(161)       # 0xA1 段重映射
    命令(200)       # 0xC8 COM 反向扫描
    命令(218)       # 0xDA COM 引脚配置
    命令(18)        # 0x12
    命令(129)       # 0x81 对比度
    命令(207)       # 0xCF
    命令(217)       # 0xD9 预充电
    命令(241)       # 0xF1
    命令(219)       # 0xDB VCOMH
    命令(64)        # 0x40
    命令(164)       # 0xA4 恢复显示
    命令(166)       # 0xA6 正常（非反色）
    命令(175)       # 0xAF 开显示

# ---------------- 绘图 ----------------

函数 字位置(字)：
    令 i = 0
    当 i < 64：
        如果 字符集[i] == 字：
            返回 i
        i = i + 1
    返回 0      # 不在字库里的字符按空格画

# ---------------- 页缓冲（双缓冲式刷新） ----------------
# 一整帧 1024 字节放进列表要 4 B × 1024 = 4 KB，RAM 余量只有 3.4 KB，放不下；
# 所以按页缓冲：128 字节（512 B 堆）里把一整页拼好，再成段推给屏。
# 屏上内容在没有被新页覆盖前一直保持，不再每帧清屏，避免整屏闪白。

令 缓冲 = [0]
循环 7 次：                 # 1 → 2 → 4 → … → 128 个槽位（列表连接，不依赖追加）
    缓冲 = 缓冲 + 缓冲

函数 缓冲清零()：
    令 i = 0
    当 i < 屏宽：
        缓冲[i] = 0
        i = i + 1

# 从 起列 开始写一段文本到缓冲（每字 5 列 + 1 列空隙），不碰屏。
函数 缓冲画段(文本内容, 起列)：
    令 列 = 起列
    遍历 字 在 文本内容：
        如果 列 > 122：
            中断
        令 基 = 字位置(字) * 5
        令 k = 0
        当 k < 5：
            如果 列 < 屏宽：
                缓冲[列] = 字库[基 + k]
            列 = 列 + 1
            k = k + 1
        列 = 列 + 1

# 把缓冲整页推给屏：5 字节一段，一次事务连续写，128 字节 = 25 段 + 尾 3 字节。
函数 推页(页)：
    设行(页)
    令 基 = 0
    当 基 + 4 < 屏宽：
        I2C写块(屏址, 64, 缓冲[基], 缓冲[基 + 1], 缓冲[基 + 2], 缓冲[基 + 3], 缓冲[基 + 4])
        基 = 基 + 5
    I2C写块(屏址, 64, 缓冲[125], 缓冲[126], 缓冲[127])

# 拼一整页并推出：先清缓冲（不是清屏），再写文本，再整页推。
函数 画页(页, 文本内容)：
    缓冲清零()
    缓冲画段(文本内容, 4)
    推页(页)

# 只在开机做一次：8 页全写 0，建立干净底图；之后不再清屏。
函数 首次清屏()：
    令 页号 = 0
    当 页号 < 8：
        缓冲清零()
        推页(页号)
        页号 = 页号 + 1

# ---------------- 诊断：扫描 0x00–0x7F ----------------

函数 扫描():
    打印("I2C 地址扫描（0x00–0x7F）：")
    令 找到 = 0
    遍历 地址 在 范围(0, 128):
        如果 I2C探测(地址):
            打印("  ACK 地址 =", 地址)
            找到 = 找到 + 1
    如果 找到 == 0:
        打印("  没有任何应答。分步检查：")
        打印("  1) VCC 是否 3V3、GND 是否共地")
        打印("  2) SDA/SCL 是否接反（SCL=PB10，SDA=PB11）")
        打印("  3) SCL/SDA 空闲是否约 3.3V（上拉是否有效）")
        打印("  4) 模块是不是 SPI 版（四针丝印不是 GND/VCC/SCL/SDA 就要停）")
    返回 找到

# ---------------- 计时辅助 ----------------

# 定时器计数 是 SysTick 毫秒计数的低 16 位（约 65.5 秒回绕），跨回绕时补 65536。
函数 毫秒差(起, 止)：
    令 d = 止 - 起
    如果 d < 0：
        d = d + 65536
    返回 d

# ---------------- 主流程 ----------------

打印("砾：SSD1306 128×64 I2C 显示")
打印("接线：PB10=SCL，PB11=SDA，VCC=3V3，GND=GND（模块自带 4.7k 上拉）")

定时器初始化()
令 硬件 = I2C初始化(26, 27, 400)
如果 硬件：
    打印("I2C 模式：硬件 I2C2（PB10/PB11，400 kHz 快速模式，APB1=36 MHz）")
否则：
    打印("I2C 模式：软件位翻转（几十 kHz，靠外部上拉）")

如果 扫描():
    屏初始化()
    首次清屏()
    画页(0, "LI")
    画页(2, "JISHI MICRO")
    画页(4, "OLED 128X64")
    令 计数 = 1
    令 上次毫秒 = 0
    打印("持续刷新：只有第 6 页（计数器）每帧重画，其它页保持不动；最后一行右侧是上一帧整页写入的毫秒")
    当 真:
        令 t0 = 定时器计数()
        缓冲清零()
        缓冲画段(文本(计数), 4)
        缓冲画段(文本(上次毫秒) + "MS", 64)
        推页(6)
        令 t1 = 定时器计数()
        上次毫秒 = 毫秒差(t0, t1)
        定时器延时(500)
        计数 = 计数 + 1
否则：
    打印("未找到 I2C 设备，未初始化屏幕")
