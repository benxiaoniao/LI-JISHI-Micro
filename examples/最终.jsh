最终 类 点:
    令 x = 0
    令 y = 0
    函数 初始化(a, b):
        本.x = a
        本.y = b
    函数 描述():
        返回 "(" + 文本(本.x) + "," + 文本(本.y) + ")"

类 基础:
    令 名字 = "基础"
    最终 函数 版本():
        返回 "v1"
    函数 介绍():
        返回 本.名字 + ":" + 本.版本()

类 扩展 继承 基础:
    令 标签 = "扩展"
    函数 介绍():
        返回 超.介绍() + "+" + 本.标签
    函数 版本副本():
        返回 超.版本()

令 p = 新建 点(3, 4)
打印("最终类:", p.描述())
p.x = 5
打印("改字段:", p.描述())

令 e = 新建 扩展()
打印("最终方法继承:", e.介绍(), e.版本副本())
