打印("砾：小数（Q12 定点，精度 1/4096）")
打印("加法 =", 1.5 + 2.25)
打印("减法 =", 5.0 - 1.25)
打印("乘法 =", 3.0 * 2.5)
打印("除法（除不尽）=", 10.0 / 4)
打印("ADC 换算 =", 4094 / 4095.0 * 3300)
打印("0.1 + 0.2 =", 0.1 + 0.2)
打印("整除 =", 7 // 2)
打印("小数整除 =", 7.5 // 2)
打印("取余 =", 7.5 % 2)
打印("幂 =", 2.0 ** 10)
打印("负数 =", -1.25)
打印("绝对值 =", 绝对值(-2.5))
打印("最小精度 =", 1.0 / 4096)
打印("大数 =", 500000.0 + 1000.0)
打印("整数(3.9) =", 整数(3.9))
打印("小数(3) =", 小数(3))
打印("类型(1.5) =", 类型(1.5))
打印("文本 =", 文本(1.5))
如果 1.5:
    打印("非零小数为真")
如果 0.0:
    打印("零小数为真")
否则:
    打印("零小数为假")
打印("比较 1.0 == 1 =", 1.0 == 1)
打印("比较 1.5 > 1 =", 1.5 > 1)
打印("比较 1.5 <= 1.5 =", 1.5 <= 1.5)
