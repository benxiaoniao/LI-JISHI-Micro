# 基本抛出与捕获
尝试:
    抛出 "出事了"
捕获 原因:
    打印("基本:", 原因)

# 抛出任意值：字典
尝试:
    抛出 {"码": 7, "说明": "坏输入"}
捕获 值:
    打印("字典码:", 值["码"], 值["说明"])

# 跨函数传播
函数 检查(n):
    如果 n < 0:
        抛出 "负数: " + 文本(n)
    返回 n * 2

尝试:
    打印(检查(-3))
捕获 原因:
    打印("跨函数:", 原因)

# 嵌套 try：内层捕获后外层继续
尝试:
    尝试:
        抛出 "内层"
    捕获 原因:
        打印("内层捕获:", 原因)
    打印("外层继续")
捕获 原因:
    打印("不该出现")

# 捕获块里再抛，继续向外传播
函数 包装():
    尝试:
        抛出 "第一层"
    捕获 原因:
        抛出 "包装: " + 原因
    返回 "不会到这里"

尝试:
    打印(包装())
捕获 原因:
    打印("再抛:", 原因)

# 返回写在 try 内
函数 安全取(n):
    尝试:
        如果 n > 10:
            抛出 "太大"
        返回 n + 1
    捕获 原因:
        返回 -1

打印("返回:", 安全取(3), 安全取(20))

# 中断 / 继续 写在 try 内
令 总和 = 0
遍历 i 在 范围(0, 5):
    尝试:
        如果 i == 1:
            继续
        如果 i == 3:
            中断
        总和 += i
    捕获 原因:
        打印("循环捕获:", 原因)
打印("总和:", 总和)

# 匿名捕获
尝试:
    抛出 [1, 2]
捕获:
    打印("匿名捕获")

# 抛出小数
尝试:
    抛出 3.5
捕获 值:
    打印("小数:", 值)
