导入 队列
导入 任务

令 队 = 队列创建(3)

函数 消费():
    令 收 = 0
    当 真:
        令 v = 队列接收(队, 2000)
        如果 v == 空:
            打印("消费：收齐", 收, "条")
            返回
        收 += 1
        打印("消费 <-", v)

打印("生产/消费：root 发 3 条，子任务收")
创建(消费)
令 i = 1
当 i <= 3:
    打印("生产 ->", i)
    队列发送(队, i, 0)
    i += 1
打印("生产：3 条已发")
延时(2200)
打印("根任务结束")
