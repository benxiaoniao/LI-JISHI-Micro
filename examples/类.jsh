类 计数器:
    令 值 = 0
    令 步长 = 1
    函数 初始化(起点, 步):
        本.值 = 起点
        本.步长 = 步
    函数 加(n):
        本.值 = 本.值 + n * 本.步长
    函数 读():
        返回 本.值
    函数 造加法器():
        函数 加一():
            本.加(1)
        返回 加一

类 点:
    令 x = 0
    令 y = 0

类 包裹:
    令 内容 = 空
    函数 初始化(v):
        本.内容 = v

令 c = 新建 计数器(5, 2)
打印("初始:", c.读())
c.加(3)
打印("加3后:", c.读(), "字段:", c.值)

令 p = 新建 点()
p.x = 3
p.y = 4
打印("点:", p)

令 队列 = [空, 空, 空]
令 i = 0
当 i < 3:
    令 q = 新建 点()
    q.x = i
    队列[i] = q
    i += 1
打印("队列:", 队列)

函数 查点(k):
    如果 k < 0:
        抛出 新建 包裹("下标越界: " + 文本(k))
    返回 新建 点()
尝试:
    查点(-1)
捕获 原因:
    打印("捕获:", 原因)
    打印("内容:", 原因.内容)

令 加一 = c.造加法器()
令 前 = c.读()
加一()
加一()
打印("闭包捕获本:", 前, "->", c.读())

c.值 += 4
打印("字段改写:", c.值)
