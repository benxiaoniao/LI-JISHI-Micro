# 集合：无序去重，元素限不可变值（整数/文本/空/真/假/小数）

令 s = 集合()
打印(集合加入(s, 1))      # 真：新增
打印(集合加入(s, 2))      # 真
打印(集合加入(s, 1))      # 假：已存在
打印(长度(s))
打印(s)
打印(集合有(s, 2))        # 真
打印(集合有(s, 9))        # 假
打印(集合删除(s, 1))      # 真
打印(集合删除(s, 1))      # 假：已经删掉
打印(长度(s))
打印(类型(s))

# 遍历按插入顺序
令 词 = 集合()
集合加入(词, "甲")
集合加入(词, "乙")
集合加入(词, "甲")
遍历 w 在 词:
    打印("词", w)
打印(长度(词))

# 空集合
令 空集 = 集合()
打印(长度(空集), 空集)
