# 列表解构：长度必须完全相等，多的少的都落到「其他」
遍历 值 在 [[1, 2], [1, 2, 3], [9, 8]]:
    匹配 值:
        情形 [甲, 乙]:
            打印("二元:", 甲, 乙)
        情形 [甲, 乙, 丙]:
            打印("三元:", 甲, 乙, 丙)
        情形 其他:
            打印("其他")

# 字典解构：列出的键必须都在，多余的键忽略
匹配 {"类型": "点", "值": [3, 4]}:
    情形 {"类型": 名, "值": [x, y]}:
        打印("点:", 名, x, y)
    情形 其他:
        打印("不是点")

# 键缺失 / 类型不符都走「其他」，按分支顺序尝试
遍历 数据 在 [{"码": 200, "体": "好"}, {"码": 500}, [1, 2]]:
    匹配 数据:
        情形 {"码": 码, "体": 体}:
            打印("响应:", 码, 体)
        情形 {"码": 码}:
            打印("只有码:", 码)
        情形 [一, 二]:
            打印("列表:", 一, 二)
        情形 其他:
            打印("其他")

# 解构里的元素也可以是字面量或区间
匹配 [1, 5]:
    情形 [1, 4..6]:
        打印("区间元素命中")
    情形 其他:
        打印("不该出现")

匹配 [1, 9]:
    情形 [1, 4..6]:
        打印("不该出现")
    情形 其他:
        打印("区间元素未命中")

# 列表里嵌字典
匹配 [{"名": "温度", "值": 25}, 3]:
    情形 [{"名": 名, "值": 值}, 数量]:
        打印("读数:", 名, 值, 数量)
    情形 其他:
        打印("不是读数")

# 空列表只匹配空列表
匹配 []:
    情形 []:
        打印("空列表")
    情形 其他:
        打印("不该出现")

# 绑定是普通局部变量，闭包可以捕获
函数 求和(对):
    匹配 对:
        情形 [甲, 乙]:
            令 加 = 函数(): 甲 + 乙
            返回 加()
        情形 其他:
            返回 0

打印("闭包捕获:", 求和([10, 20]))

# 模块顶层的绑定就是全局名
匹配 [7, 8]:
    情形 [七, 八]:
        打印("模块级:", 七, 八)
    情形 其他:
        打印("其他")
