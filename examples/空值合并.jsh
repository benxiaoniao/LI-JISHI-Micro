类 盒:
    令 值 = 0

    函数 加倍() -> 整数:
        返回 本.值 * 2

    函数 加(数: 整数) -> 整数:
        返回 本.值 + 数

令 空盒 = 空
令 盒一 = 新建 盒()
盒一.值 = 7

打印(空盒?.值)
打印(盒一?.值)
打印(空盒?.值 ?? 99)
打印(盒一?.值 ?? 99)
打印(空盒?.加倍(), 盒一?.加倍())

函数 记() -> 整数:
    打印("实参求值")
    返回 1

打印(空盒?.加(记()))
打印(盒一?.加(记()))

令 空表 = 空
令 表 = [10, 20]
打印(空表?[0], 表?[1])

函数 备选() -> 整数:
    打印("备选执行")
    返回 5

打印(空 ?? 备选())
打印(3 ?? 备选())

令 外 = 空
令 取 = 函数():
    返回 外 ?? 6
打印(取())
