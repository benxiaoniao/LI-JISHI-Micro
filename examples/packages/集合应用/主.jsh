令 数 = [1, 2, 3, 4, 5]

打印("平方:", 集合.映射(数, 函数(x): x * x))
打印("偶数:", 集合.过滤(数, 函数(x): x % 2 == 0))
打印("求和:", 集合.归约(数, 0, 函数(累, x): 累 + x))
打印("有负数:", 集合.任意(数, 函数(x): x < 0))
打印("全正数:", 集合.全部(数, 函数(x): x > 0))

# 空表：映射/过滤得空表，归约得初值，任意为假、全部为真
令 空表 = []
打印("空:", 集合.映射(空表, 函数(x): x), 集合.过滤(空表, 函数(x): 真), 集合.归约(空表, 100, 函数(a, b): a + b), 集合.任意(空表, 函数(x): 真), 集合.全部(空表, 函数(x): 假))

# 闭包捕获外部变量；判定函数抛出的异常向外传播
令 阈值 = 3
尝试:
    打印("大于阈值:", 集合.过滤(数, 函数(x): x > 阈值))
    令 检查 = 函数(x):
        如果 x == 4:
            抛出 "四不行"
        返回 x
    令 坏 = 集合.映射(数, 检查)
    打印("不该出现:", 坏)
捕获 原因:
    打印("捕获:", 原因)
