类 动物:
    令 名字 = "动物"
    函数 叫():
        返回 "……"
    函数 介绍():
        返回 "我是" + 本.名字 + "，" + 本.叫()

类 狗 继承 动物:
    令 品种 = "中华田园犬"
    函数 叫():
        返回 "汪汪"
    函数 介绍():
        返回 超.介绍() + "（品种：" + 本.品种 + "）"
    函数 父类叫声():
        返回 超.叫()
    函数 闭包调父类():
        令 f = 函数(): 超.叫()
        返回 f()

类 幼犬 继承 狗:
    函数 叫():
        返回 "嗷"
    函数 介绍():
        返回 超.介绍() + "，还小"

令 a = 新建 动物()
打印("动物:", a.介绍())

令 d = 新建 狗()
打印("狗:", d.介绍())
打印("显式父类叫声:", d.父类叫声())
打印("闭包里的超:", d.闭包调父类())

令 p = 新建 幼犬()
打印("幼犬:", p.介绍())
