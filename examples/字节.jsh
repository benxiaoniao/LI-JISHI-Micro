# 字节：不可变原始字节串；长度 / 遍历 / 下标都按字节，而不是 UTF-8 码点

令 b = 字节("砾")            # 文本 → UTF-8 原始字节
打印(长度(b))
打印(字节十六进制(b))
打印(字节取(b, 0))
打印(字节取(b, -1))         # 负下标：最后一字节

令 手工 = 字节([1, 2, 255])
打印(手工)
打印(字节列表(手工))

# 拼接与相等（按内容逐字节比较）
令 头 = 字节([1])
令 尾 = 字节([2])
打印(头 + 尾)
打印(头 + 尾 == 字节([1, 2]))

# 十六进制往返：允许空格与大小写
令 从文本 = 十六进制字节("00 ff 1A")
打印(从文本, 长度(从文本))
打印(字节十六进制(从文本))
打印(字节十六进制(字节("")))  # 空字节 → 空文本

# 遍历按字节给整数
遍历 x 在 字节([7, 8]):
    打印("字节", x)
打印(类型(手工))

# 文本往返
打印(字节文本(字节("砾")))
