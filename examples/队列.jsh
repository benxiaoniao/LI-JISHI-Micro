导入 队列
导入 信号量

打印("队列与信号量")
令 队 = 队列创建(2)
打印("队列句柄 =", 队)
打印("发送 11 =", 队列发送(队, 11))
打印("发送 22 =", 队列发送(队, 22))
打印("已满再发 33 =", 队列发送(队, 33))
打印("数量 =", 队列数量(队))
打印("接收 =", 队列接收(队))
打印("接收 =", 队列接收(队))
打印("空队列接收 =", 队列接收(队))
打印("数量 =", 队列数量(队))

令 信 = 信号量创建(0, 1)
打印("信号量句柄 =", 信)
打印("空等 =", 信号量等待(信))
打印("给出 =", 信号量给出(信))
打印("已满再给 =", 信号量给出(信))
打印("等待 =", 信号量等待(信))
打印("等待后计数空 =", 信号量等待(信))
